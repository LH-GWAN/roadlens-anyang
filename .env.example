# RoadLens Anyang 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 git 에 커밋하지 마세요.
# cp .env.example .env

# ── 기상청 단기예보 조회서비스 ─────────────────────────────────────────────
# https://www.data.go.kr/data/15084084/openapi.do 에서 활용신청 후 발급받은 일반 인증키(Decoding)
# 값이 없으면 강수 정보 자동 조회는 비활성화되고 화면에서 직접 입력합니다.
KMA_SERVICE_KEY=

# 기상청 격자 좌표 (안양시 기본값). 다른 지역을 조회하려면 변경하세요.
KMA_NX=60
KMA_NY=121

# ── 모델 ──────────────────────────────────────────────────────────────────
# 비워 두면 models/best.onnx -> models/best.pt 순서로 자동 탐색합니다.
MODEL_PATH=

# 탐지 신뢰도 기본 임계값 (0.0 ~ 1.0)
DETECTION_CONF_THRESHOLD=0.25

# ── 개인정보 처리 ─────────────────────────────────────────────────────────
# 얼굴 비식별(모자이크) 처리 사용 여부
FACE_BLUR_ENABLED=true

# 원본 사진 저장 여부. 기본값 false = 비식별 처리된 사진만 저장합니다.
# true 로 바꾸면 원본이 디스크에 남으므로 개인정보 처리 방침을 먼저 확인하세요.
STORE_ORIGINAL_IMAGE=false

# ── 경로 계산 ─────────────────────────────────────────────────────────────
# 외부 도로망 API 를 연동한 경우에만 true. 기본값 false = Haversine 근사 경로.
ROUTING_API_ENABLED=false
