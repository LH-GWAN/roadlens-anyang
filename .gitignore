# 환경변수 / 비밀정보
.env

# 가상환경
.venv/
venv/

# 공공데이터 CSV(data/raw/*.csv)는 공공누리 제1유형(출처표시)이라 저장소에 포함한다

# 처리 결과
data/processed/*
!data/processed/.gitkeep

# 모델 가중치: 시연용 best.onnx(12 MB) 는 커밋에 포함한다. 그 외 학습 중간 가중치만 제외
models/*.pt
models/*.pth

# 실행 산출물: 학습 지표(json/csv)와 탐지 예시 이미지는 커밋에 포함한다
outputs/*.log
outputs/tmp_*

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# OS
.DS_Store
