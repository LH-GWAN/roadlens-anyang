# 환경변수 / 비밀정보
.env

# 가상환경
.venv/
venv/

# 실제 내려받은 공공데이터 (재배포 조건 확인 필요)
data/raw/anyang_road_damage.csv
data/raw/school_zones.csv

# 처리 결과
data/processed/*
!data/processed/.gitkeep

# 모델 가중치: 시연용 best.onnx(12 MB) 는 커밋에 포함한다. 그 외 학습 중간 가중치만 제외
models/*.pt
models/*.pth

# 실행 산출물: 학습 지표(json/csv)와 탐지 예시 이미지는 커밋에 포함한다
outputs/*.log
outputs/tmp_*

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# OS
.DS_Store
